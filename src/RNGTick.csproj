<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RNGTick</AssemblyName>
    <RootNamespace>RNGTick</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <ModId>RNGTick</ModId>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never copy game assemblies next to the mod DLL. -->
    <Reference Include="Atomcraft">
      <HintPath>$(GameDataDir)/Atomcraft.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony is bundled by the mod loader; never ship 0Harmony.dll. -->
    <!-- IL weaving: InlineMethod.Fody rewrites calls to [Inline] methods into their bodies after
         the compiler has run. Neither package ships with the mod. -->
    <PackageReference Include="Fody" Version="6.8.1" PrivateAssets="all" />
    <PackageReference Include="InlineMethod.Fody" Version="0.8.7" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="../ModZip.targets" />

</Project>
