<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RNGTick</AssemblyName>
    <RootNamespace>RNGTick</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <ModId>RNGTick</ModId>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never copy game assemblies next to the mod DLL. -->
    <Reference Include="Atomcraft">
      <HintPath>$(GameDataDir)/Atomcraft.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony is bundled by the mod loader; never ship 0Harmony.dll. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The generator runs inside the compiler, so it is referenced as an analyzer and its own
         assembly is never shipped. ReferenceOutputAssembly=false is what keeps it out of the mod. -->
    <ProjectReference Include="../gen/RNGTick.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Write the generated sources next to the build so a diff can show what was produced. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Written for inspection, compiled from memory. Without this the SDK's **/*.cs glob would
         also compile them off disk and every generated type would be defined twice. -->
    <Compile Remove="generated/**/*.cs" />
  </ItemGroup>

  <Import Project="../ModZip.targets" />

</Project>
