<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RNGTick.Test</AssemblyName>
    <RootNamespace>RNGTick.Test</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <ModId>RNGTick.Test</ModId>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Atomcraft">
      <HintPath>$(GameDataDir)/Atomcraft.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Atomcraft.TestHarness">
      <HintPath>$(TestHarnessDir)/Atomcraft.TestHarness.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The mod under test. Referenced, never shipped: the loader loads it from its own zip. -->
    <ProjectReference Include="../src/RNGTick.csproj">
      <Private>false</Private>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="RequireTestHarnessDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(TestHarnessDir)' == '' OR !Exists('$(TestHarnessDir)/Atomcraft.TestHarness.dll')"
           Text="No Atomcraft.TestHarness.dll under TestHarnessDir='$(TestHarnessDir)'. Build the harness first, then build this through ../Testing/build-mod.sh." />
  </Target>

  <Import Project="../ModZip.targets" />

</Project>
